{
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'",
    "Referrer-Policy": "no-referrer",
    "X-Content-Type-Options": "nosniff",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  },
  "mimeTypes": {
    ".webm": "audio/webm",
    ".woff2": "font/woff2"
  },
  "platform": {
    "apiRuntime": "node:22"
  },
  "routes": [
    {
      "route": "/stats.html",
      "allowedRoles": [
        "owner"
      ],
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "route": "/api/stats",
      "allowedRoles": [
        "owner"
      ]
    },
    {
      "route": "/.auth/login/twitter",
      "statusCode": 404
    },
    {
      "route": "/.auth/login/aad",
      "statusCode": 404
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/github?post_login_redirect_uri=/stats.html",
      "statusCode": 302
    },
    "403": {
      "rewrite": "/index.html"
    }
  }
}